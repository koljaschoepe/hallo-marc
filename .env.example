# IP des SmallTV im WLAN. Finden mit:  make discover
# Tipp: im Router eine feste DHCP-Reservierung anlegen, dann bleibt sie gleich.
SMALLTV_IP=192.168.178.XXX

# Theme fuer "eigenes Bild" (Ultra = 3, Pro = 4). Muss man normalerweise nicht aendern.
SMALLTV_IMAGE_THEME=3

# Wetter (Open-Meteo, kein API-Key). Default: Dresden-Striesen.
WEATHER_LAT=51.0447
WEATHER_LON=13.7770
WEATHER_NAME=Striesen

# Abfahrtstafel (VVO, kein API-Key). 33000084 = Zwinglistraße.
# Andere Haltestelle finden:  python3 -m smalltv.transit find "Schillerplatz"
VVO_STOP_ID=33000084
# Optional nur bestimmte Linien, kommagetrennt (leer = alle):
VVO_LINES=
# Abfahrten, die du zu Fuss nicht mehr schaffst, ausblenden (Minuten):
VVO_WALK_MIN=3

# Companion-Daemon: Anzeigedauer eines Hinweises (s) und Queue-Datei
SMALLTV_SHOW_SECONDS=20
SMALLTV_QUEUE=/tmp/smalltv_queue.jsonl
